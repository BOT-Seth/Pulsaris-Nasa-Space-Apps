// Extracted from the accepted corrected viewer. Returns display RGB.
// Supply normalized view-space normals and normalized object-space positions.
// Do not apply a second gamma conversion to this result.
float chalkHash(vec3 p){p=fract(p*.1031);p+=dot(p,p.yzx+33.33);return fract((p.x+p.y)*p.z);}vec3 chalkColor(vec3 viewNormal, vec3 modelPosition){vec3 N=normalize(viewNormal);vec3 light=vec3(0.54180136,0.51654992,0.47070813)*(1.) + vec3(0.18796121,0.18776839,0.18082083)*(N.x) + vec3(0.11938340,0.13795038,0.15246916)*(N.y) + vec3(0.01326649,0.01436807,0.00234177)*(N.z) + vec3(-0.02109325,-0.02053044,-0.01891571)*(N.x*N.y) + vec3(0.04756549,0.05151650,0.05043459)*(N.y*N.z) + vec3(0.04427350,0.04703913,0.05131445)*(3.*N.z*N.z-1.) + vec3(0.04310281,0.04845117,0.05593277)*(N.x*N.z) + vec3(-0.03067551,-0.02678714,-0.02034585)*(N.x*N.x-N.y*N.y);light=clamp(light,vec3(.14),vec3(.96));float grain=(chalkHash(floor(modelPosition*6500.))-.5)*.008;return clamp(pow(light,vec3(1./2.2))+grain,0.,1.);}
